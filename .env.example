# YT-Factory Orchestrator Environment Configuration

# MCP Gateway Configuration
# Command to start the MCP Gateway (can be a path or command)
MCP_GATEWAY_COMMAND=uv run python -m src
MCP_GATEWAY_CWD=../mcp-gateway/mcp-gateway

# Mock mode - set to true to use mock responses instead of real APIs
MOCK_MODE=false

# ── LLM Provider ────────────────────────────────────────────────
# Active provider for all pipeline (non-NotebookLM) generation.
LLM_PROVIDER=deepseek            # deepseek | gemini

# DeepSeek (primary). Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # override if needed
# DEEPSEEK_RATE_LIMIT_RPM=60
# DEEPSEEK_API_TIMEOUT_MS=120000

# Gemini (fallback provider). Also used by the legacy NotebookLM path.
GEMINI_API_KEY=AIza...
# GEMINI_FAST_MODEL=gemini-2.5-flash
# GEMINI_SMART_MODEL=gemini-2.5-pro

# LLM content-hash cache (Phase 3)
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# Legacy NotebookLM path (don't change) — uses GEMINI_API_KEY above.
# GOOGLE_API_KEY is consumed by the mcp-gateway, not the orchestrator.

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Directories
INCOMING_DIR=./incoming
ACTIVE_PROJECTS_DIR=./active_projects
DATA_DIR=./data

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_CONNECTIONS=5

# Heartbeat interval in milliseconds
HEARTBEAT_INTERVAL_MS=60000

# Stale project thresholds (milliseconds)
STALE_ANALYZING_MS=600000
STALE_RENDERING_MS=1800000
STALE_UPLOADING_MS=300000
