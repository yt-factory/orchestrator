{
  "name": "orchestrator",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "process": "bun run src/index.ts --once",
    "process:force": "FORCE_NO_LLM_CACHE=1 bun run src/index.ts --once",
    "clean-llm-cache": "rm -rf .cache/llm",
    "typecheck": "tsc --noEmit",
    "feedback": "bun run src/cli/feedback.ts",
    "channel": "bun run src/cli/channel.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/nunjucks": "^3.2.6",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "generic-pool": "^3.9.0",
    "nunjucks": "^3.2.4",
    "openai": "^6.44.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
